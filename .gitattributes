# Set default behavior for all files
* text=auto

# Cross-platform source and config (LF)
*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.config text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.spec text eol=lf
.coveragerc text eol=lf
pylintrc text eol=lf
pytest.ini text eol=lf
mypy.ini text eol=lf
*.sh text eol=lf
.shellcheckrc text eol=lf
tests/unix_stubs/* text eol=lf
Makefile text eol=lf
makefile text eol=lf
*.mk text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf

# Windows-native scripts (CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.reg text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Spec conformance corpus: preserve exact bytes for line-ending oracles
spec/corpus/** -text

# Binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pdb binary
*.obj binary
*.o binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.svg binary
*.tiff binary
*.webp binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Linguist overrides
vendor/** linguist-vendored
